VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (used by api/summarize.js and api/digest.js on Vercel) — do not prefix with VITE_.
ANTHROPIC_API_KEY=

# Server-side only (used by api/admin-roles.js on Vercel) — the Supabase
# service role key, from Project Settings > API > service_role (secret).
# Full admin power over your project. Never prefix with VITE_ — that would
# bundle it into client code and expose it to every visitor.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only (used by api/travel-advisor.js) — both optional. Without
# them, the Travel agent still works, it just skips live flight search
# and/or local headlines and says so in the briefing.
#
# Amadeus for Developers (https://developers.amadeus.com) self-service app,
# free tier — note this hits their TEST environment (test.api.amadeus.com),
# which is real sandbox data, not guaranteed live/bookable production prices.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# NewsAPI.org (https://newsapi.org) free "Developer" tier. That plan's terms
# are for development/non-commercial use — fine to start with, but worth
# checking their pricing if this sees real ongoing internal use.
NEWS_API_KEY=
